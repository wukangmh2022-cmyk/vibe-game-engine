    {"id":"set-style-detailed","primary_command_type":"SET_ELEMENT_STYLE","sample_mode":"motif","intent":"创建 id 为 back_button 的返回图标，位置 x=30,y=30，尺寸 60x60；随后将它的 style.display 设置为 none。","asset_catalog":[{"id":"____","type":"image","path":"images/old/返回图标.png","name":"返回图标","origin":"existing","exists":true}]},
