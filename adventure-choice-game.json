{
  "id": "adventure-choice-game",
  "name": "冒险选择游戏",
  "description": "一个基于选择的冒险游戏，展示嵌套分支和得分系统",
  "version": "1.0.0",
  "globalVariables": {
    "score": 0,
    "health": 100,
    "gold": 50,
    "hasKey": false,
    "hasSword": false,
    "currentLocation": "forest"
  },
  "globalSwitches": {},
  "audio": {
    "globalVolume": 0.8
  },
  "levels": [
    {
      "id": "adventure-start",
      "name": "冒险开始",
      "description": "你是一名勇敢的冒险者，站在神秘森林的入口",
      "canvasWidth": 800,
      "canvasHeight": 600,
      "initialState": {
        "score": 0,
        "health": 100,
        "gold": 50,
        "hasKey": false,
        "hasSword": false,
        "currentLocation": "forest"
      },
      "commands": [
        {
          "id": "show-forest-background",
          "type": "SHOW_IMAGE",
          "parameters": {
            "elementId": "background",
            "resourceId": "forest-bg",
            "position": { "x": 0, "y": 0 },
            "size": { "width": 800, "height": 600 },
            "zIndex": 0
          }
        },
        {
          "id": "show-title",
          "type": "SHOW_TEXT",
          "parameters": {
            "elementId": "game-title",
            "text": "🗡️ 冒险选择游戏 🗡️",
            "position": { "x": 50, "y": 20 },
            "style": {
              "fontSize": "32px",
              "color": "#2c3e50",
              "fontWeight": "bold",
              "textAlign": "center",
              "textShadow": "2px 2px 4px rgba(0,0,0,0.5)",
              "zIndex": 10
            }
          }
        },
        {
          "id": "show-story",
          "type": "SHOW_TEXT",
          "parameters": {
            "elementId": "story-text",
            "text": "你站在一片神秘的森林前。传说这里隐藏着古老的宝藏，但也充满了危险。你决定...",
            "position": { "x": 50, "y": 80 },
            "style": {
              "fontSize": "18px",
              "color": "#34495e",
              "maxWidth": "600px",
              "lineHeight": "1.6"
            }
          }
        },
        {
          "id": "show-stats",
          "type": "SHOW_TEXT",
          "parameters": {
            "elementId": "stats-display",
            "text": "💰 金币: 50 | ❤️ 生命: 100 | ⭐ 得分: 0",
            "position": { "x": 50, "y": 140 },
            "style": {
              "fontSize": "16px",
              "color": "#27ae60",
              "fontWeight": "bold"
            }
          }
        },
        {
          "id": "choice-1-enter-forest",
          "type": "SHOW_BUTTON",
          "parameters": {
            "elementId": "btn-enter-forest",
            "text": "🌲 勇敢地进入森林",
            "position": { "x": 100, "y": 200 },
            "size": { "width": 200, "height": 50 },
            "style": {
              "backgroundColor": "#27ae60",
              "color": "white",
              "fontSize": "16px",
              "border": "none",
              "borderRadius": "8px",
              "cursor": "pointer"
            },
            "onClick": "enter-forest"
          }
        },
        {
          "id": "choice-2-buy-equipment",
          "type": "SHOW_BUTTON",
          "parameters": {
            "elementId": "btn-buy-equipment",
            "text": "🛡️ 先去村庄买装备",
            "position": { "x": 350, "y": 200 },
            "size": { "width": 200, "height": 50 },
            "style": {
              "backgroundColor": "#3498db",
              "color": "white",
              "fontSize": "16px",
              "border": "none",
              "borderRadius": "8px",
              "cursor": "pointer"
            },
            "onClick": "buy-equipment"
          }
        },
        {
          "id": "choice-3-gather-info",
          "type": "SHOW_BUTTON",
          "parameters": {
            "elementId": "btn-gather-info",
            "text": "📚 先收集情报",
            "position": { "x": 225, "y": 270 },
            "size": { "width": 200, "height": 50 },
            "style": {
              "backgroundColor": "#9b59b6",
              "color": "white",
              "fontSize": "16px",
              "border": "none",
              "borderRadius": "8px",
              "cursor": "pointer"
            },
            "onClick": "gather-info"
          }
        }
      ],
      "events": [
        {
          "id": "enter-forest-event",
          "name": "进入森林事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'button:click' && event.action === 'enter-forest'"
              }
            }
          ],
          "commands": [
            {
              "id": "hide-initial-choices",
              "type": "HIDE_ELEMENTS",
              "parameters": {
                "elementIds": ["btn-enter-forest", "btn-buy-equipment", "btn-gather-info"]
              }
            },
            {
              "id": "update-story-forest",
              "type": "UPDATE_TEXT",
              "parameters": {
                "elementId": "story-text",
                "text": "你勇敢地走进了森林。不久，你遇到了一只受伤的小鹿。你注意到前方有两条路..."
              }
            },
            {
              "id": "forest-choice-condition",
              "type": "if_condition",
              "parameters": {
                "condition": {
                  "type": "expression",
                  "expression": "context.stateManager.getVariable('gold') >= 30"
                },
                "trueCommands": [
                  {
                    "id": "show-help-deer-choice",
                    "type": "SHOW_BUTTON",
                    "parameters": {
                      "elementId": "btn-help-deer",
                      "text": "💝 帮助小鹿 (花费30金币)",
                      "position": { "x": 100, "y": 350 },
                      "size": { "width": 220, "height": 50 },
                      "style": {
                        "backgroundColor": "#e74c3c",
                        "color": "white",
                        "fontSize": "16px",
                        "border": "none",
                        "borderRadius": "8px",
                        "cursor": "pointer"
                      },
                      "onClick": "help-deer"
                    }
                  }
                ],
                "falseCommands": [
                  {
                    "id": "show-no-money-message",
                    "type": "SHOW_TEXT",
                    "parameters": {
                      "elementId": "no-money-msg",
                      "text": "💸 你的金币不足，无法帮助小鹿",
                      "position": { "x": 100, "y": 350 },
                      "style": {
                        "fontSize": "16px",
                        "color": "#e74c3c"
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "show-left-path-choice",
              "type": "SHOW_BUTTON",
              "parameters": {
                "elementId": "btn-left-path",
                "text": "⬅️ 走左边的小径",
                "position": { "x": 350, "y": 350 },
                "size": { "width": 180, "height": 50 },
                "style": {
                  "backgroundColor": "#f39c12",
                  "color": "white",
                  "fontSize": "16px",
                  "border": "none",
                  "borderRadius": "8px",
                  "cursor": "pointer"
                },
                "onClick": "left-path"
              }
            },
            {
              "id": "show-right-path-choice",
              "type": "SHOW_BUTTON",
              "parameters": {
                "elementId": "btn-right-path",
                "text": "➡️ 走右边的大路",
                "position": { "x": 225, "y": 420 },
                "size": { "width": 180, "height": 50 },
                "style": {
                  "backgroundColor": "#16a085",
                  "color": "white",
                  "fontSize": "16px",
                  "border": "none",
                  "borderRadius": "8px",
                  "cursor": "pointer"
                },
                "onClick": "right-path"
              }
            }
          ]
        },
        {
          "id": "return-start-event",
          "name": "返回开始事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'button:click' && event.action === 'return-start'"
              }
            }
          ],
          "commands": [
            {
              "id": "trigger-game-over-return",
              "type": "GAME_OVER",
              "parameters": {
                "reason": "return",
                "score": "${score}",
                "level": "${level}",
                "time": "${gameTime}",
                "message": "你选择了返回，冒险到此结束。",
                "resetGame": true
              }
            },
            {
              "id": "show-return-message",
              "type": "SHOW_TEXT",
              "parameters": {
                "elementId": "return-text",
                "text": "🔙 你选择了返回，冒险到此结束。",
                "position": { "x": 50, "y": 200 },
                "style": {
                  "fontSize": "24px",
                  "color": "#f39c12",
                  "fontWeight": "bold",
                  "textAlign": "center",
                  "backgroundColor": "rgba(255,255,255,0.9)",
                  "padding": "15px",
                  "borderRadius": "10px",
                  "zIndex": 10
                }
              }
            },
            {
              "id": "show-game-over-screen-return",
              "type": "SHOW_IMAGE",
              "parameters": {
                "elementId": "game-over-bg",
                "resourceId": "game-over-screen",
                "position": { "x": 0, "y": 0 },
                "size": { "width": 800, "height": 600 },
                "zIndex": 5,
                "delay": 1500
              }
            }
          ]
        },
        {
          "id": "help-deer-event",
          "name": "帮助小鹿事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'button:click' && event.action === 'help-deer'"
              }
            }
          ],
          "commands": [
            {
              "id": "spend-gold-for-deer",
              "type": "set_variable",
              "parameters": {
                "key": "gold",
                "value": "${gameState.gold} - 30",
                "expression": true
              }
            },
            {
              "id": "gain-score-kindness",
              "type": "set_variable",
              "parameters": {
                "key": "score",
                "value": "${gameState.score} + 50",
                "expression": true
              }
            },
            {
              "id": "get-magic-key",
              "type": "set_variable",
              "parameters": {
                "key": "hasKey",
                "value": true
              }
            },
            {
              "id": "update-stats-after-deer",
              "type": "UPDATE_TEXT",
              "parameters": {
                "elementId": "stats-display",
                "text": "💰 金币: ${gameState.gold} | ❤️ 生命: ${gameState.health} | ⭐ 得分: ${gameState.score} | 🗝️ 魔法钥匙: ✅"
              }
            },
            {
              "id": "show-deer-reward-message",
              "type": "SHOW_TEXT",
              "parameters": {
                "elementId": "deer-reward-msg",
                "text": "🦌 小鹿感激地给了你一把魔法钥匙！+50分",
                "position": { "x": 100, "y": 500 },
                "style": {
                  "fontSize": "18px",
                  "color": "#27ae60",
                  "fontWeight": "bold"
                },
                "duration": 3000
              }
            },
            {
              "id": "hide-help-deer-button",
              "type": "HIDE_ELEMENTS",
              "parameters": {
                "elementIds": ["btn-help-deer"]
              }
            }
          ]
        },
        {
          "id": "left-path-event",
          "name": "左路事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'button:click' && event.action === 'left-path'"
              }
            }
          ],
          "commands": [
            {
              "id": "hide-path-choices",
              "type": "HIDE_ELEMENTS",
              "parameters": {
                "elementIds": ["btn-left-path", "btn-right-path", "btn-help-deer"]
              }
            },
            {
              "id": "update-story-cave",
              "type": "UPDATE_TEXT",
              "parameters": {
                "elementId": "story-text",
                "text": "你走上了左边的小径，发现了一个神秘的洞穴。洞口有一扇锁着的门..."
              }
            },
            {
              "id": "cave-door-condition",
              "type": "if_condition",
              "parameters": {
                "condition": {
                  "type": "expression",
                  "expression": "context.stateManager.getVariable('hasKey') === true"
                },
                "trueCommands": [
                  {
                    "id": "show-unlock-door-choice",
                    "type": "SHOW_BUTTON",
                    "parameters": {
                      "elementId": "btn-unlock-door",
                      "text": "🗝️ 用魔法钥匙开门",
                      "position": { "x": 200, "y": 350 },
                      "size": { "width": 200, "height": 50 },
                      "style": {
                        "backgroundColor": "#8e44ad",
                        "color": "white",
                        "fontSize": "16px",
                        "border": "none",
                        "borderRadius": "8px",
                        "cursor": "pointer"
                      },
                      "onClick": "unlock-door"
                    }
                  }
                ],
                "falseCommands": [
                  {
                    "id": "show-locked-door-message",
                    "type": "SHOW_TEXT",
                    "parameters": {
                      "elementId": "locked-door-msg",
                      "text": "🚪 门被锁住了，你需要一把钥匙才能进入",
                      "position": { "x": 200, "y": 350 },
                      "style": {
                        "fontSize": "16px",
                        "color": "#e74c3c"
                      }
                    }
                  },
                  {
                    "id": "show-return-choice",
                    "type": "SHOW_BUTTON",
                    "parameters": {
                      "elementId": "btn-return",
                      "text": "🔙 返回森林入口",
                      "position": { "x": 200, "y": 400 },
                      "size": { "width": 200, "height": 50 },
                      "style": {
                        "backgroundColor": "#95a5a6",
                        "color": "white",
                        "fontSize": "16px",
                        "border": "none",
                        "borderRadius": "8px",
                        "cursor": "pointer"
                      },
                      "onClick": "return-start"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "unlock-door-event",
          "name": "开门事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'button:click' && event.action === 'unlock-door'"
              }
            }
          ],
          "commands": [
            {
              "id": "hide-unlock-button",
              "type": "HIDE_ELEMENTS",
              "parameters": {
                "elementIds": ["btn-unlock-door"]
              }
            },
            {
              "id": "show-treasure-background",
              "type": "SHOW_IMAGE",
              "parameters": {
                "elementId": "background",
                "resourceId": "treasure-room",
                "position": { "x": 0, "y": 0 },
                "size": { "width": 800, "height": 600 },
                "zIndex": 0
              }
            },
            {
              "id": "update-story-treasure",
              "type": "UPDATE_TEXT",
              "parameters": {
                "elementId": "story-text",
                "text": "🎉 你用魔法钥匙打开了门！里面有一个宝箱，装满了金币和一把传说中的剑！"
              }
            },
            {
              "id": "gain-treasure-gold",
              "type": "set_variable",
              "parameters": {
                "key": "gold",
                "value": "${gameState.gold} + 200",
                "expression": true
              }
            },
            {
              "id": "gain-treasure-score",
              "type": "set_variable",
              "parameters": {
                "key": "score",
                "value": "${gameState.score} + 100",
                "expression": true
              }
            },
            {
              "id": "get-legendary-sword",
              "type": "set_variable",
              "parameters": {
                "key": "hasSword",
                "value": true
              }
            },
            {
              "id": "update-final-stats",
              "type": "UPDATE_TEXT",
              "parameters": {
                "elementId": "stats-display",
                "text": "💰 金币: ${gameState.gold} | ❤️ 生命: ${gameState.health} | ⭐ 得分: ${gameState.score} | 🗝️ 魔法钥匙: ✅ | ⚔️ 传说之剑: ✅"
              }
            },
            {
              "id": "show-victory-message",
              "type": "SHOW_TEXT",
              "parameters": {
                "elementId": "victory-msg",
                "text": "🏆 恭喜！你完成了冒险，获得了传说中的宝藏！最终得分: ${gameState.score}",
                "position": { "x": 100, "y": 450 },
                "style": {
                  "fontSize": "20px",
                  "color": "#f39c12",
                  "fontWeight": "bold",
                  "textAlign": "center",
                  "backgroundColor": "rgba(255,255,255,0.9)",
                  "padding": "15px",
                  "borderRadius": "10px",
                  "zIndex": 10
                }
              }
            },
            {
               "id": "trigger-game-over",
               "type": "GAME_OVER",
               "parameters": {
                 "reason": "victory",
                 "score": "${score}",
                 "level": "${level}",
                 "time": "${gameTime}",
                 "message": "恭喜你找到了传说中的宝藏！你成功完成了这次冒险！",
                 "resetGame": true
               }
             },
             {
               "id": "show-game-over-screen",
               "type": "SHOW_IMAGE",
               "parameters": {
                 "elementId": "game-over-bg",
                 "resourceId": "game-over-screen",
                 "position": { "x": 0, "y": 0 },
                 "size": { "width": 800, "height": 600 },
                 "zIndex": 5,
                 "delay": 1000
               }
             }
          ]
        },
        {
          "id": "buy-equipment-event",
          "name": "购买装备事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'button:click' && event.action === 'buy-equipment'"
              }
            }
          ],
          "commands": [
            {
              "id": "hide-initial-choices-shop",
              "type": "HIDE_ELEMENTS",
              "parameters": {
                "elementIds": ["btn-enter-forest", "btn-buy-equipment", "btn-gather-info"]
              }
            },
            {
              "id": "update-story-shop",
              "type": "UPDATE_TEXT",
              "parameters": {
                "elementId": "story-text",
                "text": "你来到了村庄的装备店。店主向你展示了各种装备..."
              }
            },
            {
              "id": "show-buy-sword-choice",
              "type": "SHOW_BUTTON",
              "parameters": {
                "elementId": "btn-buy-sword",
                "text": "⚔️ 购买铁剑 (40金币)",
                "position": { "x": 150, "y": 350 },
                "size": { "width": 180, "height": 50 },
                "style": {
                  "backgroundColor": "#34495e",
                  "color": "white",
                  "fontSize": "16px",
                  "border": "none",
                  "borderRadius": "8px",
                  "cursor": "pointer"
                },
                "onClick": "buy-sword"
              }
            },
            {
              "id": "show-buy-potion-choice",
              "type": "SHOW_BUTTON",
              "parameters": {
                "elementId": "btn-buy-potion",
                "text": "🧪 购买治疗药水 (20金币)",
                "position": { "x": 350, "y": 350 },
                "size": { "width": 200, "height": 50 },
                "style": {
                  "backgroundColor": "#e74c3c",
                  "color": "white",
                  "fontSize": "16px",
                  "border": "none",
                  "borderRadius": "8px",
                  "cursor": "pointer"
                },
                "onClick": "buy-potion"
              }
            },
            {
              "id": "show-leave-shop-choice",
              "type": "SHOW_BUTTON",
              "parameters": {
                "elementId": "btn-leave-shop",
                "text": "🚪 离开商店",
                "position": { "x": 250, "y": 420 },
                "size": { "width": 150, "height": 50 },
                "style": {
                  "backgroundColor": "#95a5a6",
                  "color": "white",
                  "fontSize": "16px",
                  "border": "none",
                  "borderRadius": "8px",
                  "cursor": "pointer"
                },
                "onClick": "leave-shop"
              }
            }
          ]
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "forest-bg",
      "type": "image",
      "url": "./images/forest-background.svg",
      "description": "森林背景图"
    },
    {
      "id": "cave-entrance",
      "type": "image",
      "url": "./images/cave-entrance.svg",
      "description": "洞穴入口图"
    },
    {
      "id": "village-shop",
      "type": "image",
      "url": "./images/village-shop.svg",
      "description": "村庄商店图"
    },
    {
      "id": "treasure-room",
      "type": "image",
      "url": "./images/treasure-room.svg",
      "description": "宝藏房间图"
    },
    {
      "id": "game-over-screen",
      "type": "image",
      "url": "./images/game-over.svg",
      "description": "游戏结束画面"
    }
  ],
  "audio": {
    "globalVolume": 0.8,
    "soundVolume": 1.0,
    "musicVolume": 0.6,
    "muted": false
  }
}