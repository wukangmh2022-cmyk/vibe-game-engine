# Vibe teacher API for command synthesis
# Copy to .env and fill real values:
#   cp agent-debugger/.env.example agent-debugger/.env
#
# Load balancing:
# - Configure 1..4 endpoints. Empty slots are ignored.
# - Workers stick to endpoints by worker_id % endpoint_count.
#   workers=4 + 2 keys => each key gets 2 workers
#   workers=8 + 4 keys => each key gets 2 workers
# - Editing this file mid-run hot-reloads on the next teacher call.

# Slot 1 (required if no other slots are filled)
VIBE_TEACHER_API_BASE_1=https://your-api-host/v1
VIBE_TEACHER_API_KEY_1=your-key-here
VIBE_TEACHER_MODEL_1=your-model-name

# Slot 2 (optional)
# VIBE_TEACHER_API_BASE_2=https://your-api-host-2/v1
# VIBE_TEACHER_API_KEY_2=your-key-2
# VIBE_TEACHER_MODEL_2=your-model-2

# Slot 3 (optional)
# VIBE_TEACHER_API_BASE_3=
# VIBE_TEACHER_API_KEY_3=
# VIBE_TEACHER_MODEL_3=

# Slot 4 (optional)
# VIBE_TEACHER_API_BASE_4=
# VIBE_TEACHER_API_KEY_4=
# VIBE_TEACHER_MODEL_4=

# Legacy single-endpoint form (still supported if no numbered slots are set)
# VIBE_TEACHER_API_BASE=https://your-api-host/v1
# VIBE_TEACHER_API_KEY=your-key-here
# VIBE_TEACHER_MODEL=your-model-name

# Optional shared overrides (hot-reloadable)
# VIBE_TEACHER_MAX_TOKENS=1200
# VIBE_TEACHER_MAX_ACTIONS=20
# VIBE_TEACHER_TOOL_PROTOCOL=openai
# VIBE_TEACHER_API_RETRIES=4
# VIBE_TEACHER_API_RETRY_BACKOFF=1.5
# VIBE_TEACHER_TIMEOUT=180

# Fixed evaluation endpoints. These are read locally by training/eval/run_eval.py
# and training/eval/run_interaction_eval.py; values are never printed.
# Start with either Qwen base profile before training, then compare it against
# VIBE_EVAL_ADAPTER_* after the LoRA server is available.
VIBE_EVAL_QWEN36_27B_API_BASE=https://your-qwen36-api-host/v1
VIBE_EVAL_QWEN36_27B_API_KEY=your-qwen36-key-here
VIBE_EVAL_QWEN36_27B_MODEL=your-qwen36-27b-model-id

VIBE_EVAL_QWEN35_9B_API_BASE=https://your-qwen35-api-host/v1
VIBE_EVAL_QWEN35_9B_API_KEY=your-qwen35-key-here
VIBE_EVAL_QWEN35_9B_MODEL=your-qwen35-9b-model-id

# Fill after serving the trained adapter. It may use the same URL/key as a base
# model, but model id must select the adapter deployment.
VIBE_EVAL_ADAPTER_API_BASE=
VIBE_EVAL_ADAPTER_API_KEY=
VIBE_EVAL_ADAPTER_MODEL=

# Independent semantic judge for training/eval/run_semantic_judge.py.
# This is an auxiliary score only; the real runtime gate remains authoritative.
VIBE_EVAL_JUDGE_API_BASE=
VIBE_EVAL_JUDGE_API_KEY=
VIBE_EVAL_JUDGE_MODEL=
