          }
        },
        {
          "id": "show-score",
          "type": "SHOW_TEXT",
          "parameters": {
            "elementId": "score-display",
            "text": "得分: 0",
            "position": { "x": 50, "y": 60 },
            "style": {
              "fontSize": "18px",
              "color": "#333",
              "fontWeight": "bold"
            }
          }
        },
        {
          "id": "show-instructions",
          "type": "SHOW_TEXT",
          "parameters": {
            "elementId": "instructions",
            "text": "拖拽水果到对应颜色的篮子中！红色水果→红色篮子，黄色水果→黄色篮子，绿色水果→绿色篮子",
            "position": { "x": 50, "y": 100 },
            "style": {
              "fontSize": "16px",
              "color": "#666",
              "maxWidth": "600px"
            }
          }
        }
      ],
      "events": [
        {
          "id": "fruit-dropped",
          "name": "水果投放事件",
          "triggers": [
            {
              "type": "custom",
              "condition": {
                "type": "expression",
                "expression": "event.type === 'drop:success'"
              }
            }
          ],
          "commands": [
            {
              "id": "check-correct-drop",
              "type": "IF_CONDITION",
              "parameters": {
                "condition": {
                  "type": "expression",
                  "expression": "(event.dropZoneId === 'red-basket' && ['apple', 'strawberry'].includes(event.draggedElementId)) || (event.dropZoneId === 'yellow-basket' && ['banana', 'lemon'].includes(event.draggedElementId)) || (event.dropZoneId === 'green-basket' && ['lime', 'kiwi'].includes(event.draggedElementId))"
                },
                "trueCommands": [
                  {
                    "id": "add-score-correct",
                    "type": "ADD_SCORE",
                    "parameters": {
                      "points": 10
                    }
                  },
                  {
                    "id": "hide-fruit",
                    "type": "SET_ELEMENT_STYLE",
                    "parameters": {
                      "elementId": "${event.draggedElementId}",
                      "style": {
                        "display": "none"
                      }
                    }
                  },
                  {
                    "id": "update-score-display",
                    "type": "UPDATE_TEXT",
                    "parameters": {
                      "elementId": "score-display",
                      "text": "得分: ${gameState.score}"
                    }
                  },
                  {
                    "id": "show-success-message",
                    "type": "SHOW_TEXT",
                    "parameters": {
                      "elementId": "success-message",
                      "text": "正确！+10分",
                      "position": { "x": 300, "y": 350 },
                      "style": {
                        "fontSize": "20px",
                        "color": "#00ff00",
                        "fontWeight": "bold"
                      },
                      "duration": 2000
                    }
                  }
                ],
                "falseCommands": [
                  {
                    "id": "show-error-message",
                    "type": "SHOW_TEXT",
                    "parameters": {
                      "elementId": "error-message",
                      "text": "错误！请放到正确的篮子中",
                      "position": { "x": 300, "y": 350 },
                      "style": {
                        "fontSize": "20px",
                        "color": "#ff0000",
                        "fontWeight": "bold"
                      },
                      "duration": 2000
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "resources": [],
  "audio": {
    "globalVolume": 0.8,
    "soundVolume": 1.0,
    "musicVolume": 0.6,
    "muted": false
  }
}