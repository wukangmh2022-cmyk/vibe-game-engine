{
  "name": "game-runtime-engine-mvp",
  "version": "1.0.0",
  "description": "数据驱动的游戏运行时引擎MVP版本",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:web": "tsc -p tsconfig.browser.json && node scripts/postbuild-web.js",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "start": "node scripts/serve.js",
    "start:port": "node scripts/serve.js 8090"
  },
  "keywords": [
    "game-engine",
    "runtime",
    "data-driven",
    "typescript",
    "mvp"
  ],
  "author": "Game Engine Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "eventemitter3": "^4.0.7"
  }
}
