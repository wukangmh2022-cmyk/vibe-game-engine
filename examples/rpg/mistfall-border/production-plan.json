{
  "brief": "雾瀑边境：唐风旅人在瀑布森林城镇寻找避瘴香，进入古遗迹封印雾兽",
  "assumptions": [
    "用户未指定范围时默认生成3张整图地图、1名主角、3名NPC、1个怪物、1条主线任务。",
    "地图使用rpg-image-map-1.0整图像素坐标协议，不使用tilemap拼块。",
    "视觉资源默认使用GPT image 2生成；缺少OPENAI_API_KEY时只生成提示词和队列。"
  ],
  "clarifyIfQualityCritical": [
    "你想要什么时代/文化/情绪基调？",
    "你希望画风更偏像素、高清2D、日系、国风还是暗黑幻想？",
    "目标是几分钟demo还是完整章节？"
  ],
  "stages": [
    "game_bible",
    "map_graph",
    "asset_queue",
    "data_compile",
    "validation",
    "asset_generation",
    "integration_playtest"
  ],
