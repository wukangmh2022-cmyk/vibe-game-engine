{
  "gameId": "basic-game",
  "title": "基础游戏示例",
  "version": "1.0.0",
  "description": "一个简单的游戏运行时引擎示例",
  "initialLevel": "level1",
  "settings": {
    "autoSave": true,
    "debugMode": false,
    "maxHistorySize": 100
  },
  "resources": {
    "images": {
      "background": "assets/images/bg.png",
      "character": "assets/images/char.png"
    },
    "sounds": {
      "bgm": "assets/audio/bgm.mp3",
      "click": "assets/audio/click.wav"
    }
  },
  "levels": {
    "level1": {
      "id": "level1",
      "title": "第一关",
      "description": "游戏开始",
      "initialVariables": {
        "playerName": "玩家",
        "score": 0
      },
      "initialSwitches": {
        "gameStarted": false,
        "musicEnabled": true
      },
      "commands": [
        {
          "id": "cmd1",
          "type": "show_text",
          "parameters": {
            "text": "欢迎来到游戏世界！",
            "position": { "x": 100, "y": 100 },
            "style": {
              "fontSize": 24,
              "color": "#ffffff"
            }
          },
          "metadata": {
            "description": "显示欢迎文本"
          }
        },
        {
          "id": "cmd2",
          "type": "set_switch",
          "parameters": {
            "key": "gameStarted",
            "value": true
          },
          "metadata": {
            "description": "标记游戏已开始"
          }
        },
        {
          "id": "cmd3",
          "type": "if_condition",
          "parameters": {
            "condition": {
              "type": "switch",
              "name": "musicEnabled",
              "operator": "eq",
              "value": true
            },
            "trueCommands": [
              {
                "id": "cmd3a",
                "type": "PLAY_SOUND",
                "parameters": {
                  "soundId": "bgm",
                  "loop": true,
                  "volume": 0.5
                }
              }
            ]
          },
          "metadata": {
            "description": "如果音乐开启则播放背景音乐"
          }
        },
        {
          "id": "cmd4",
          "type": "show_image",
          "parameters": {
            "src": "background.jpg",
            "id": "background",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600
          },
          "metadata": {
            "description": "显示背景图片"
          }
        },
        {
          "id": "cmd5",
          "type": "wait",
          "parameters": {
            "duration": 2000
          },
          "metadata": {
            "description": "等待2秒"
          }
        },
        {
          "id": "cmd6",
          "type": "add_score",
          "parameters": {
            "points": 100
          },
          "metadata": {
            "description": "增加100分"
          }
        },
        {
          "id": "cmd7",
          "type": "show_choices",
          "parameters": {
            "title": "请选择你的下一步行动：",
            "choices": [
              {
                "text": "继续探索",
                "description": "继续在游戏世界中探索",
                "value": "explore"
              },
              {
                "text": "查看背包",
                "description": "检查你的物品和装备",
                "value": "inventory"
              },
              {
                "text": "休息一下",
                "description": "恢复体力和精神",
                "value": "rest"
              }
            ],
            "timeout": 30000
          },
          "metadata": {
            "description": "显示玩家选择选项"
          }
        }
      ],
      "events": [
        {
          "name": "level_complete",
          "description": "关卡完成事件",
          "commands": [
            {
              "id": "complete1",
              "type": "show_text",
              "parameters": {
                "text": "恭喜完成第一关！",
                "position": { "x": 200, "y": 300 }
              }
            },
            {
              "id": "complete2",
              "type": "next_level",
              "parameters": {}
            }
          ]
        }
      ]
    }
  }
}