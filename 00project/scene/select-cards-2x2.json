{
  "id": "select-cards-2x2",
  "name": "多选卡片 2×2 (无翻牌)",
  "version": "1.0.0",
  "schema": "v2",
  "resources": {
    "images": [
      { "id": "card-a", "src": "images/card-a.svg" },
      { "id": "card-b", "src": "images/card-b.svg" },
      { "id": "check", "src": "images/check-circle.svg" }
    ],
    "audios": []
  },
  "levels": [
    {
      "id": "select-2x2",
      "name": "多选 2×2",
      "canvasWidth": 800,
      "canvasHeight": 600,
      "initialState": {
        "card1_selected": false,
        "card2_selected": false,
        "card3_selected": false,
        "card4_selected": false
      },
      "commands": [
        { "id": "title", "type": "SHOW_TEXT", "parameters": { "elementId": "title", "text": "✅ 点选卡片可多选 (0-4)", "position": { "x": 20, "y": 20 }, "style": { "fontSize": "24px", "color": "#ffffff" } } },

        { "id": "show-c1", "type": "SHOW_IMAGE", "parameters": { "elementId": "card-1", "resourceId": "card-a", "position": { "x": 300, "y": 160 }, "size": { "width": 120, "height": 160 }, "zIndex": 1 } },
        { "id": "selable-c1", "type": "SET_SELECTABLE", "parameters": { "elementId": "card-1", "selectable": true, "variableKey": "card1_selected", "overlayResourceId": "check", "effect": "pulse" } },

        { "id": "show-c2", "type": "SHOW_IMAGE", "parameters": { "elementId": "card-2", "resourceId": "card-a", "position": { "x": 460, "y": 160 }, "size": { "width": 120, "height": 160 }, "zIndex": 1 } },
        { "id": "selable-c2", "type": "SET_SELECTABLE", "parameters": { "elementId": "card-2", "selectable": true, "variableKey": "card2_selected", "overlayResourceId": "check", "effect": "pulse" } },

        { "id": "show-c3", "type": "SHOW_IMAGE", "parameters": { "elementId": "card-3", "resourceId": "card-b", "position": { "x": 300, "y": 340 }, "size": { "width": 120, "height": 160 }, "zIndex": 1 } },
        { "id": "selable-c3", "type": "SET_SELECTABLE", "parameters": { "elementId": "card-3", "selectable": true, "variableKey": "card3_selected", "overlayResourceId": "check", "effect": "pulse" } },

        { "id": "show-c4", "type": "SHOW_IMAGE", "parameters": { "elementId": "card-4", "resourceId": "card-b", "position": { "x": 460, "y": 340 }, "size": { "width": 120, "height": 160 }, "zIndex": 1 } },
        { "id": "selable-c4", "type": "SET_SELECTABLE", "parameters": { "elementId": "card-4", "selectable": true, "variableKey": "card4_selected", "overlayResourceId": "check", "effect": "pulse" } }
      ]
    }
  ]
}
